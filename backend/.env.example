# Copy to backend/.env and fill in. Never commit the real .env.

# Local dev defaults (docker-compose overrides these)
DATABASE_URL=sqlite+aiosqlite:///./dev.db
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173

# GitHub App (see docs/SETUP_GITHUB_APP.md)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_WEBHOOK_SECRET=

# LLM: anthropic | openai | fake (fake needs no key; good for trying things out)
LLM_PROVIDER=fake
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_REQUESTS_PER_MINUTE=30

# Running PR tests executes untrusted code; only enable on a machine with Docker
RUN_TESTS=false
TEST_COMMAND=pip install -q -r requirements.txt && pytest -q
